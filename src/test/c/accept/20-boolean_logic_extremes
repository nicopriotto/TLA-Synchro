// Extreme boolean logic combinations
boolean global_flag = false;

int complex_boolean_test() {
    boolean a = true;
    boolean b = false;
    boolean c = true;
    boolean d = false;
    
    // Complex boolean expressions
    boolean result1 = (a and b) or (c and not d);
    boolean result2 = not (a or b) and (c or d);
    boolean result3 = (a and (b or c)) and not (d and (a or b));
    
    // Boolean with arithmetic comparisons
    int x = 5;
    int y = 10;
    boolean result4 = (x < y) and ((x + y) > 10) and not (x == y);
    
    if (result1 or result2 or result3 or result4) {
        global_flag = true;
        return 1;
    } else {
        global_flag = false;
        return 0;
    }
}

int main() {
    int test_result = complex_boolean_test();
    
    if (global_flag and (test_result > 0)) {
        print(1);
    } else {
        print(0);
    }
    
    return test_result;
}
