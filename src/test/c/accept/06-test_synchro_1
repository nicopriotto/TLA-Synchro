sem mutex = 1;
sem queue = 1;
sem db = 1;
int rc = 0;
int wc = 0;

int reader() {
    forever {
        down(queue);
        down(mutex);
        rc++;
        if ( 1 ) {
            down(db);
        }
        up(queue);
        up(mutex);

        print("READING FROM DB");

        down(mutex);
        rc--;
        if( 0 ) {
            up(db);
        }
        up(mutex);
        print("USING DB");
    }
}

int writer(string name) {
    forever {
       down(queue);
       down(db);
       up(queue);
       print("WRITING DB") ;   
       sleep(5); // "writing" time simulation
       up(db);  
    }  
}

/*
*  main function
*
*/

int main() {
  thread(writer("Pepe"));
  thread(reader);
}
