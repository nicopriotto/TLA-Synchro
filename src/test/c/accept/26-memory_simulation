// Simulating memory management patterns
int memory_pool = 1000;
int allocated_blocks = 0;

int allocate_memory(int size) {
    if (memory_pool >= size) {
        memory_pool = memory_pool - size;
        allocated_blocks++;
        return size;
    } else {
        return 0;
    }
}

int free_memory(int size) {
    memory_pool = memory_pool + size;
    if (allocated_blocks > 0) {
        allocated_blocks--;
    }
    return memory_pool;
}

int memory_stress_test() {
    int total_allocated = 0;
    
    for (int i = 1; i <= 10; i++) {
        int block_size = i * 10;
        int allocated = allocate_memory(block_size);
        
        if (allocated > 0) {
            total_allocated = total_allocated + allocated;
            print(allocated);
        }
        
        // Randomly free some memory
        if (i % 3 == 0 and allocated_blocks > 0) {
            free_memory(block_size / 2);
        }
    }
    
    return total_allocated;
}

int main() {
    int result = memory_stress_test();
    
    print(memory_pool);
    print(allocated_blocks);
    
    return result;
}
