// Stress testing function parameters
int many_params(int a, int b, int c, int d, int e, float f, boolean g, string h) {
    int result = a + b + c + d + e;
    
    if (g) {
        result = result + f;
    }
    
    return result;
}

int param_passing_test() {
    int x = 1;
    int y = 2;
    float z = 3.5;
    boolean flag = true;
    string msg = "test";
    
    // Complex parameter expressions
    int result = many_params(
        x + y,
        x * y,
        x - y,
        x / (y + 1),
        x % (y + 1),
        z * 2.0,
        flag and (x < y),
        msg
    );
    
    return result;
}

int main() {
    int test_result = param_passing_test();
    print(test_result);
    
    // Function calls as parameters
    int final_result = many_params(
        param_passing_test(),
        test_result,
        0,
        1,
        2,
        1.0,
        true,
        "final"
    );
    
    return final_result;
}
