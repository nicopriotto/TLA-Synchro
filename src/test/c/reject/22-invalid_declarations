// Invalid variable and function declarations
// Multiple main functions
int main() {
    return 0;
}

int main() {  // Duplicate main function
    return 1;
}

// Invalid variable declarations
int;                    // Missing identifier
int 123invalid;         // Identifier starts with number
int int;                // Reserved keyword as identifier
int x, y, ;            // Missing identifier in list

// Invalid initializations
int x = ;              // Missing initializer value
int y = int;           // Invalid initializer
boolean flag = 123;    // Type mismatch in initialization

// Invalid function declarations
int function(int x, int x) {  // Duplicate parameter names
    return x;
}

// Invalid parameter types
int bad_function(invalid_type param) {
    return 0;
}
